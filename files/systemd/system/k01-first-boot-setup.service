[Unit]
Description=k01-os: provision Kali and Arch/AUR distrobox containers on first boot
After=network-online.target podman.socket
Wants=network-online.target
ConditionPathExists=!/var/lib/k01-os/.provisioned

[Service]
Type=oneshot
ExecStart=/usr/bin/k01-first-boot-setup.sh
RemainAfterExit=yes
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
